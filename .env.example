# ===== Database (Neon) =====
# Neon dashboard > Connect > salin connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ===== Login admin =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# String acak panjang, misalnya hasil: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ===== Kunci untuk ESP32 =====
# Harus sama dengan DEVICE_API_KEY di firmware ESP32
DEVICE_API_KEY=ganti-dengan-kunci-rahasia-esp32

# ===== MQTT (opsional, untuk tampilan live dan perintah palang) =====
# Sisi server (user dengan izin publish), contoh HiveMQ Cloud:
MQTT_URL=mqtts://xxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Sisi browser dashboard (user khusus yang hanya boleh subscribe):
NEXT_PUBLIC_MQTT_WS_URL=wss://xxxx.s1.eu.hivemq.cloud:8884/mqtt
NEXT_PUBLIC_MQTT_USERNAME=
NEXT_PUBLIC_MQTT_PASSWORD=
